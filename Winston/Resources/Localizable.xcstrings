    "Winston blocked a redirect from HTTPS to insecure HTTP." : {
      "comment" : "Error message when a redirect from HTTPS to insecure HTTP is blocked.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
